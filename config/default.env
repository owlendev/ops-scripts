# Default settings. Do NOT put client-specific values here.
# Copy examples/*.env to a per-client file and pass it with:  bootstrap.sh -c <file>
#
# Values here use ${VAR:=default} so you can also override them with
# environment variables, e.g.  sudo SSH_PORT=2222 ./bootstrap.sh

# ---- Modules (yes/no) ------------------------------------------------------
: "${ENABLE_SYSTEM_UPDATE:=yes}"     # apt upgrade, timezone, hostname
: "${ENABLE_BASE_TOOLS:=yes}"        # curl, git, jq, htop, network tools...
: "${ENABLE_CLI_TOOLS:=yes}"         # ripgrep, fd, fzf, bat, eza, zoxide, btop... (see CLI_TOOLS)
: "${ENABLE_SWAP:=yes}"              # swap file on small instances
: "${ENABLE_FIREWALL:=yes}"          # UFW: deny inbound except SSH/HTTP/HTTPS
: "${ENABLE_SSH_HARDENING:=yes}"     # keys only, no root login
: "${ENABLE_FAIL2BAN:=yes}"          # ban brute-force SSH attempts
: "${ENABLE_AUTO_UPDATES:=yes}"      # unattended security updates
: "${ENABLE_KERNEL_HARDENING:=yes}"  # network sysctl hardening
: "${ENABLE_TAILSCALE:=no}"          # Tailscale VPN: private access to this server
: "${ENABLE_DEV_TOOLS:=no}"          # git, lazygit, lazydocker, Neovim + LazyVim, herdr (see DEV_TOOLS)
: "${ENABLE_DOCKER:=no}"             # Docker Engine + compose plugin
: "${ENABLE_AWS_CLI:=no}"            # AWS CLI v2
: "${ENABLE_NGINX:=no}"              # nginx + certbot
: "${ENABLE_APP_PROXY:=no}"          # Caddy in front of all your Docker apps + the ops-app command (needs docker)
: "${ENABLE_ADGUARD:=no}"            # AdGuard Home DNS server (run it on its own small VM/LXC)

# ---- General ---------------------------------------------------------------
: "${ADMIN_USER:=${SUDO_USER:-ubuntu}}"  # the login user (EC2 Ubuntu = ubuntu, Debian = admin)
: "${TIMEZONE:=UTC}"
: "${HOSTNAME_FQDN:=}"                   # e.g. web1.client.com (empty = leave as is)
: "${LOG_FILE:=/var/log/ops-bootstrap.log}"
: "${RUN_AUDIT:=yes}"                    # run checks/audit.sh after bootstrap
: "${REBOOT_IF_REQUIRED:=no}"            # reboot at the end if a kernel update needs it

# ---- Packages --------------------------------------------------------------
: "${BASE_PACKAGES:=ca-certificates curl wget gnupg git vim nano htop tmux jq unzip zip rsync lsof tree bash-completion dnsutils net-tools iproute2 iputils-ping traceroute mtr-tiny tcpdump netcat-openbsd nmap whois}"
: "${EXTRA_PACKAGES:=}"

# ---- Modern CLI tools (apt package names; ones your OS lacks are skipped) ---
: "${CLI_TOOLS:=ripgrep fd-find fzf bat eza zoxide btop ncdu duf tealdeer git-delta httpie iftop nethogs iotop-c sysstat strace lnav plocate}"
: "${CLI_SHELL_INTEGRATION:=yes}"   # ll/lt aliases, zoxide 'z', fzf Ctrl-R/Ctrl-T for all bash users

# ---- Dev tools (installed for ADMIN_USER) ---------------------------------
# Choose from: git lazygit lazydocker neovim lazyvim herdr
# Pre-ticked: git lazygit neovim. Add lazydocker, lazyvim or herdr when you want them.
: "${DEV_TOOLS:=git lazygit neovim}"
: "${GIT_USER_NAME:=}"    # git config user.name for ADMIN_USER
: "${GIT_USER_EMAIL:=}"   # git config user.email for ADMIN_USER

# ---- Tailscale -------------------------------------------------------------
: "${TAILSCALE_AUTHKEY:=}"     # tskey-auth-... (empty = log in later with 'sudo tailscale up'). SECRET: keep out of git
: "${TAILSCALE_HOSTNAME:=}"    # name in your tailnet (empty = system hostname)
: "${TAILSCALE_SSH:=no}"       # Tailscale SSH: log in with your tailnet identity, no keys
: "${TAILSCALE_TAGS:=}"        # e.g. tag:server (must be allowed in your tailnet policy)
: "${TAILSCALE_SSH_ONLY:=no}"  # close public SSH once Tailscale is connected (HTTP/HTTPS stay public)
: "${TAILSCALE_ADVERTISE_ROUTES:=}"  # subnet router: share LAN addresses with the tailnet, e.g. 192.168.1.50/32 192.168.1.2/32

# ---- Swap ------------------------------------------------------------------
: "${SWAP_SIZE:=auto}"   # auto = 2G when RAM < 4G, otherwise none. Or e.g. 1G, 4G, 0

# ---- Firewall (UFW) --------------------------------------------------------
: "${FIREWALL_ALLOW_HTTP:=yes}"
: "${FIREWALL_ALLOW_HTTPS:=yes}"
: "${FIREWALL_EXTRA_PORTS:=}"   # space separated, e.g. "8080/tcp 51820/udp"
: "${SSH_ALLOW_FROM:=}"         # CIDR allowed to SSH, e.g. 203.0.113.4/32 (empty = anywhere)

# ---- SSH -------------------------------------------------------------------
: "${SSH_PORT:=22}"             # if changed, also open it in the EC2 security group!
: "${SSH_ALLOW_USERS:=}"        # space separated; empty = any user with a key
: "${SSH_ALLOW_TCP_FORWARDING:=yes}"  # needed for ssh -L tunnels (e.g. to a DB)

# ---- fail2ban --------------------------------------------------------------
: "${FAIL2BAN_BANTIME:=1h}"
: "${FAIL2BAN_FINDTIME:=10m}"
: "${FAIL2BAN_MAXRETRY:=5}"

# ---- Automatic updates -----------------------------------------------------
: "${AUTO_UPDATES_REBOOT:=no}"        # let unattended-upgrades reboot when needed
: "${AUTO_UPDATES_REBOOT_TIME:=03:30}"

# ---- Docker ----------------------------------------------------------------
: "${DOCKER_ADD_ADMIN_TO_GROUP:=yes}"

# ---- nginx / HTTPS ---------------------------------------------------------
: "${INSTALL_CERTBOT:=yes}"
: "${CERTBOT_DOMAINS:=}"   # space separated, e.g. "example.com www.example.com"
: "${CERTBOT_EMAIL:=}"     # required with CERTBOT_DOMAINS

# ---- App proxy (Caddy + ops-app) -------------------------------------------
# Every app gets https://<name>.<APPS_DOMAIN>. Only Caddy publishes ports (80/443).
: "${APPS_DOMAIN:=home.internal}"   # *.internal is reserved for private networks; or a domain you own
: "${APPS_DIR:=/srv/apps}"          # one folder per app: $APPS_DIR/<name>/compose.yml
: "${PROXY_TLS:=internal}"          # internal = Caddy's own CA (trust it once per device)
                                    # cloudflare = real Let's Encrypt certs via DNS (needs a domain on Cloudflare)
: "${PROXY_CF_API_TOKEN:=}"         # PROXY_TLS=cloudflare only: token with Zone.DNS edit. SECRET: keep out of git
: "${PROXY_ACME_EMAIL:=}"           # PROXY_TLS=cloudflare only: Let's Encrypt expiry notices
: "${PROXY_ALLOW_FROM:=private_ranges 100.64.0.0/10}"  # who may connect: LAN + Tailscale. Everyone else gets 403
: "${PROXY_SUBNET:=172.30.0.0/24}"  # subnet of the shared 'proxy' Docker network (change if it clashes with your LAN)

# ---- AdGuard Home ----------------------------------------------------------
: "${ADGUARD_REWRITES:=}"           # local names, space separated, e.g. "*.home.internal=192.168.1.50"
: "${ADGUARD_USER:=admin}"          # web UI login
: "${ADGUARD_PASSWORD:=}"           # empty = generated and saved to /root/adguard-admin.txt. SECRET: keep out of git
: "${ADGUARD_UPSTREAMS:=}"          # empty = AdGuard's default (Quad9 over HTTPS); e.g. "https://dns.cloudflare.com/dns-query"
