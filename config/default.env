# Default settings. Do NOT put client-specific values here.
# Copy examples/*.env to a per-client file and pass it with:  bootstrap.sh -c <file>
#
# Values here use ${VAR:=default} so you can also override them with
# environment variables, e.g.  sudo SSH_PORT=2222 ./bootstrap.sh

# ---- Modules (yes/no) ------------------------------------------------------
: "${ENABLE_SYSTEM_UPDATE:=yes}"     # apt upgrade, timezone, hostname
: "${ENABLE_BASE_TOOLS:=yes}"        # curl, git, jq, htop, network tools...
: "${ENABLE_SWAP:=yes}"              # swap file on small instances
: "${ENABLE_FIREWALL:=yes}"          # UFW: deny inbound except SSH/HTTP/HTTPS
: "${ENABLE_SSH_HARDENING:=yes}"     # keys only, no root login
: "${ENABLE_FAIL2BAN:=yes}"          # ban brute-force SSH attempts
: "${ENABLE_AUTO_UPDATES:=yes}"      # unattended security updates
: "${ENABLE_KERNEL_HARDENING:=yes}"  # network sysctl hardening
: "${ENABLE_DOCKER:=no}"             # Docker Engine + compose plugin
: "${ENABLE_AWS_CLI:=no}"            # AWS CLI v2
: "${ENABLE_NGINX:=no}"              # nginx + certbot

# ---- General ---------------------------------------------------------------
: "${ADMIN_USER:=${SUDO_USER:-ubuntu}}"  # the login user (EC2 Ubuntu = ubuntu, Debian = admin)
: "${TIMEZONE:=UTC}"
: "${HOSTNAME_FQDN:=}"                   # e.g. web1.client.com (empty = leave as is)
: "${LOG_FILE:=/var/log/ops-bootstrap.log}"
: "${RUN_AUDIT:=yes}"                    # run checks/audit.sh after bootstrap
: "${REBOOT_IF_REQUIRED:=no}"            # reboot at the end if a kernel update needs it

# ---- Packages --------------------------------------------------------------
: "${BASE_PACKAGES:=ca-certificates curl wget gnupg git vim nano htop tmux jq unzip zip rsync lsof tree bash-completion dnsutils net-tools iproute2 iputils-ping traceroute mtr-tiny tcpdump netcat-openbsd nmap whois}"
: "${EXTRA_PACKAGES:=}"

# ---- Swap ------------------------------------------------------------------
: "${SWAP_SIZE:=auto}"   # auto = 2G when RAM < 4G, otherwise none. Or e.g. 1G, 4G, 0

# ---- Firewall (UFW) --------------------------------------------------------
: "${FIREWALL_ALLOW_HTTP:=yes}"
: "${FIREWALL_ALLOW_HTTPS:=yes}"
: "${FIREWALL_EXTRA_PORTS:=}"   # space separated, e.g. "8080/tcp 51820/udp"
: "${SSH_ALLOW_FROM:=}"         # CIDR allowed to SSH, e.g. 203.0.113.4/32 (empty = anywhere)

# ---- SSH -------------------------------------------------------------------
: "${SSH_PORT:=22}"             # if changed, also open it in the EC2 security group!
: "${SSH_ALLOW_USERS:=}"        # space separated; empty = any user with a key
: "${SSH_ALLOW_TCP_FORWARDING:=yes}"  # needed for ssh -L tunnels (e.g. to a DB)

# ---- fail2ban --------------------------------------------------------------
: "${FAIL2BAN_BANTIME:=1h}"
: "${FAIL2BAN_FINDTIME:=10m}"
: "${FAIL2BAN_MAXRETRY:=5}"

# ---- Automatic updates -----------------------------------------------------
: "${AUTO_UPDATES_REBOOT:=no}"        # let unattended-upgrades reboot when needed
: "${AUTO_UPDATES_REBOOT_TIME:=03:30}"

# ---- Docker ----------------------------------------------------------------
: "${DOCKER_ADD_ADMIN_TO_GROUP:=yes}"

# ---- nginx / HTTPS ---------------------------------------------------------
: "${INSTALL_CERTBOT:=yes}"
: "${CERTBOT_DOMAINS:=}"   # space separated, e.g. "example.com www.example.com"
: "${CERTBOT_EMAIL:=}"     # required with CERTBOT_DOMAINS
