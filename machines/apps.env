# Apps VM: Docker apps (Kontor, Nextcloud...) at https://<name>.home.internal
# A Debian VM with Docker and one Caddy in front of every app. Apps never fight
# over ports: Caddy owns 80/443 and picks the app by name, with HTTPS.
# Add apps afterwards with ops-app (adopt Kontor, new Nextcloud, any image).
# A VM rather than an LXC because Docker is reliable in a VM: it gets its own
# kernel, and Proxmox updates can't break it.
# If you've made the AdGuard machine already, its *.home.internal name is set
# to point here automatically.
#
# ask: APPS_DOMAIN | Apps domain | Apps get https://<name>.<this>. Keep home.internal unless you own a domain.
# ask: TIMEZONE | Timezone | e.g. UTC, Asia/Riyadh
# next: Log in: ssh {user}@{ip}   then: ops-app help
# next: On each device, open http://ca.{APPS_DOMAIN} once and install the certificate (needs DNS from the AdGuard machine).
# next: Your own app from Git (Kontor...): sudo ops-app deploy kontor git@github.com:you/kontor.git  (or: sudo /opt/ops-scripts/ops → Apps)
# next: Nextcloud: ops-app new nextcloud --template nextcloud && ops-app up nextcloud
#
# Also works on a machine you made yourself:  sudo ./bootstrap.sh -c machines/apps.env
PVE_KIND=vm
PVE_CORES=2
PVE_MEMORY=4096
PVE_DISK=64

ENABLE_DOCKER=yes
ENABLE_APP_PROXY=yes
ENABLE_DEV_TOOLS=yes
DEV_TOOLS="git lazygit lazydocker neovim"
APPS_DOMAIN=home.internal
PROXY_TLS=internal

# Later, to reach the apps from anywhere: Tailscale here, sharing this VM and the
# AdGuard machine with your tailnet (README → "Home lab on Proxmox" → Tailscale).
# ENABLE_TAILSCALE=yes
# TAILSCALE_HOSTNAME=apps
# TAILSCALE_ADVERTISE_ROUTES="192.168.1.50/32 192.168.1.2/32"
