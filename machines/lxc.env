# Plain LXC: a small hardened Debian container, ready for whatever you install
# Debian with updates, firewall, SSH keys only, fail2ban and automatic security
# updates, and nothing else. Good for one service that doesn't need Docker.
# Want the same thing again later? Copy this file to machines/<name>.env, add
# the modules you want (ENABLE_...=yes), and it shows up here as a new recipe.
#
# ask: TIMEZONE | Timezone | e.g. UTC, Asia/Riyadh
# next: Log in: ssh {user}@{ip}   (or from this Proxmox host: pct enter {id})
PVE_KIND=lxc
PVE_CORES=1
PVE_MEMORY=1024
PVE_DISK=8
