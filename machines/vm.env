# Plain VM: a hardened Debian VM, ready for whatever you install
# Like the plain LXC, but a full VM with its own kernel. Use it for things that
# need one: Docker, VPNs, kernel modules, or anything that misbehaves in an LXC.
# Copy this file to machines/<name>.env to make your own recipe from it.
#
# ask: TIMEZONE | Timezone | e.g. UTC, Asia/Riyadh
# next: Log in: ssh {user}@{ip}
PVE_KIND=vm
PVE_CORES=2
PVE_MEMORY=2048
PVE_DISK=32
