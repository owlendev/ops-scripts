# Docker host: apps run in containers behind nginx.
# Publish container ports on 127.0.0.1 only (e.g. "127.0.0.1:3000:3000"),
# because Docker-published ports bypass UFW.

HOSTNAME_FQDN=app1.example.com
TIMEZONE=UTC

ENABLE_DOCKER=yes
ENABLE_NGINX=yes
ENABLE_AWS_CLI=yes   # e.g. to pull from ECR using the instance's IAM role

SWAP_SIZE=2G
