# Website server: nginx + HTTPS. Copy to clients/<client>.env and edit.
#   sudo ./bootstrap.sh -c clients/acme.env

HOSTNAME_FQDN=web1.example.com
TIMEZONE=Asia/Riyadh

ENABLE_NGINX=yes
ENABLE_DOCKER=no

# Leave empty until DNS points to the server, then re-run: --only nginx
CERTBOT_DOMAINS="example.com www.example.com"
CERTBOT_EMAIL=admin@example.com

# Lock SSH to your office/VPN IP (the EC2 security group should match)
# SSH_ALLOW_FROM=203.0.113.4/32
